  ch1Subtitles:
  - "\u5982\u679C\u628A\u89C6\u7EBF\u62C9\u8FD1\u4FEF\u89C6\u6574\u4E2A\u6545\u4E8B\u7684\u80CC\u666F\uFF0C\u5C31\u4F1A\u53D1\u73B0\uFF0C\u5728\u832B\u832B\u6D77\u57DF\u4E2D\uFF0C\u6709\u4E00\u5EA7\u5C0F\u5C0F\u7684\u7EFF\u8272\u5B64\u5C9B\uFF0C\u88AB\u6D77\u6C34\u62F1\u536B\u7740\uFF0C\u50CF\u662F\u7AE5\u8BDD\u4E2D\u7684\u9B54\u6CD5\u57CE\u5821\u3002"
  - "\u7537\u5B69\u6B63\u5750\u5728\u78A7\u83B9\u83B9\u7684\u5C0F\u5C9B\u5CB8\u8FB9\uFF0C\u75F4\u8FF7\u5730\u76EF\u7740\u5929\u5730\u5C3D\u5934\u90A3\u7EDA\u70C2\u7684\u5149\u5F69\uFF0C\u4ED6\u4ECE\u5C0F\u4E0E\u7237\u7237\u751F\u6D3B\u5728\u8FD9\u5EA7\u5B64\u5C9B\u4E0A\uFF0C\u4F46\u4ED6\u7684\u5FC3\u91CC\uFF0C\u85CF\u7740\u4E00\u4E2A\u4E0D\u613F\u56FF\u4E8E\u6B64\u7684\u68A6\u60F3\u3002"
  - "\u4E00\u8258\u6F02\u4EAE\u7684\u6E14\u8239\u7A81\u7136\u51FA\u73B0\u5728\u89C6\u7EBF\u91CC\uFF0C\u662F\u7237\u7237\u6355\u9C7C\u5F52\u6765\u4E86\u3002\u90A3\u8258\u8239\u5212\u5F00\u4E86\u5E73\u9759\u7684\u6D77\u9762\uFF0C\u4E5F\u8E81\u52A8\u4E86\u7537\u5B69\u7684\u5FC3\u3002"
  - "\u7537\u5B69\u4E0A\u524D\u7D27\u7D27\u5730\u62E5\u4F4F\u7237\u7237\uFF0C\u201C\u7237\u7237\u2014\u2014\u660E\u5929\u6211\u60F3\u4E0E\u60A8\u4E00\u8D77\u51FA\u6D77\u6355\u9C7C\u2014\u2014\u201D\uFF0C\u7237\u7237\u540C\u610F\u4E86\u3002\u7537\u5B69\u4ECE\u6B64\u548C\u7237\u7237\u4E00\u8D77\u51FA\u6D77\uFF0C\u770B\u904D\u671D\u5347\u6C50\u843D\u3002"
  - "\u201C\u7237\u7237\uFF0C\u770B\u3002\u201D\u4E00\u5929\uFF0C\u7537\u5B69\u6307\u5411\u6D77\u7684\u5C3D\u5934\uFF0C\u201C\u6211\u8981\u5230\u8FDC\u65B9\u53BB\u3002\u201D"
  - "\u8001\u4EBA\u7684\u624B\u6296\u4E86\u4E00\u4E0B\uFF0C\u7EE7\u7EED\u7740\u6536\u7F51\u7684\u52A8\u4F5C\uFF0C\u201C\u4F60\u4F55\u65F6\u51FA\u53D1\uFF1F\u201D\u6D77\u98CE\u5439\u6765\uFF0C\u98A4\u6296\u4E86\u8001\u4EBA\u7684\u58F0\u97F3\uFF0C\u6B65\u5C65\u4EFF\u4F5B\u4E5F\u591A\u4E86\u51E0\u5206\u8E52\u8DDA\u3002"
  - "\u5C11\u5E74\u79BB\u5F00\u5B64\u5C9B\u90A3\u5929\u6E05\u6668\u5FAE\u98CE\u8F7B\u62C2\uFF0C\u5927\u8239\u6E10\u6E10\u8FDC\u79BB\u4E86\u5C0F\u5C9B\uFF0C\u5C11\u5E74\u54ED\u7740\u5BF9\u7237\u7237\u558A\uFF1A\u201C\u7237\u7237\uFF0C\u4F60\u7B49\u6211\u8863\u9526\u8FD8\u4E61\u2014\u2014\u201D"
  - "\u5C11\u5E74\u6CA1\u6CE8\u610F\u5230\u7237\u7237\u4E00\u591C\u95F4\u82B1\u767D\u7684\u5934\u53D1\uFF0C\u8239\u8D8A\u6765\u8D8A\u8FDC\uFF0C\u7237\u7237\u7684\u8EAB\u5F71\u8D8A\u6765\u8D8A\u6E3A\u5C0F\uFF0C\u6700\u540E\u5982\u8584\u96FE\u822C\u6D88\u6563\u3002"
  ch2Images:
  - {fileID: 21300000, guid: f1d8edf9f41c6cf49810a12e66532caa, type: 3}
  - {fileID: 21300000, guid: 0cbfd48917263744e9862c38beedeeb2, type: 3}
  - {fileID: 21300000, guid: 3a0057feffed30546b597804b882e6ba, type: 3}
  - {fileID: 21300000, guid: b7846b64ee035834a8769ba2203e182e, type: 3}
  - {fileID: 21300000, guid: a47ce90bebda5a34cbc9041912c44003, type: 3}
  - {fileID: 21300000, guid: c70fe9386c873a844968131894b6f8c1, type: 3}
  - {fileID: 21300000, guid: 02cba4541892956428103ceaeb40f08d, type: 3}
  - {fileID: 21300000, guid: 9a714419afef36545913913ad408d2f5, type: 3}
  ch2Subtitles:
  - "\u5C11\u5E74\u5750\u5728\u5C0F\u8239\u4E0A\uFF0C\u8138\u4E0A\u6EE1\u662F\u60CA\u559C\uFF1A\u8FDC\u5904\u7684\u6D77\u5CB8\u7EBF\u6E05\u6670\u53EF\u89C1\uFF0C\u6D77\u9762\u6CE2\u5149\u7CBC\u7CBC\uFF0C\u6E05\u6668\u7684\u9633\u5149\u6D12\u5728\u6C34\u9762\u4E0A\u3002"
  - "\u5C11\u5E74\u628A\u5C0F\u8239\u505C\u5728\u6D77\u6EE9\u8FB9\uFF0C\u671B\u5411\u8FBD\u9614\u7684\u6D77\u5CB8\u7EBF\u548C\u8302\u5BC6\u7684\u6811\u6797\uFF0C\u4E00\u5207\u662F\u90A3\u4E48\u7684\u4E0E\u4F17\u4E0D\u540C\u3002"
  - "\u5C11\u5E74\u7EE7\u7EED\u524D\u884C\uFF0C\u5374\u610F\u5916\u53D1\u73B0\u4E86\u4E00\u4E2A\u53D7\u4F24\u7684\u7537\u5B69\u3002\u7537\u5B69\u8EAB\u4E0A\u90FD\u662F\u4E00\u9053\u9053\u4F24\u75D5\uFF0C\u663E\u7136\u4F24\u5F97\u4E0D\u8F7B\u3002"
  - "\u5C11\u5E74\u5C06\u7537\u5B69\u80CC\u5230\u6811\u4E0B\uFF0C\u5728\u6797\u5B50\u4E2D\u627E\u4E86\u4E9B\u8349\u836F\u7ED9\u5C11\u5E74\u6577\u4E0A\u3002\u7537\u5B69\u7528\u611F\u6FC0\u7684\u76EE\u5149\u671B\u5411\u5C11\u5E74\uFF0C\u6700\u540E\u4ED6\u8BF4\uFF1A\u201C\u8C22\u8C22\u4F60\uFF0C\u670B\u53CB\u3002\u201D"
  - "\u4E24\u4EBA\u6F2B\u6B65\u5728\u6797\u95F4\uFF0C\u201C\u670B\u53CB\u662F\u4EC0\u4E48\uFF1F\u201D\u7537\u5B69\u6709\u4E9B\u5403\u60CA\uFF0C\u4F46\u968F\u5373\u89E3\u91CA\u9053\uFF1A\u201C\u670B\u53CB\u5C31\u662F\u966A\u5728\u4F60\u8EAB\u8FB9\uFF0C\u8BA9\u4F60\u5FEB\u4E50\u7684\u90A3\u4E2A\u4EBA\u3002\u201D\u5C11\u5E74\u53C8\u60F3\u8D77\u4E86\u7237\u7237\u548C\u90A3\u5EA7\u5B64\u5C9B\u3002"
  - "\u5C0F\u65F6\u5019\uFF0C\u7237\u7237\u4F1A\u4E3A\u4ED6\u6458\u4E0B\u7EA2\u7EA2\u7684\u82F9\u679C\uFF0C\u90A3\u662F\u4E00\u6BB5\u5E78\u798F\u7684\u7AE5\u5E74\u65F6\u5149\u3002\u4ED6\u60F3\uFF1A\u7237\u7237\u5C31\u662F\u4ED6\u7684\u670B\u53CB\u3002"
  - "\u4E24\u4EBA\u5E76\u6392\u8EBA\u5728\u8349\u5730\u4E0A\uFF0C\u611F\u53D7\u591C\u98CE\u7684\u5439\u62C2\u3002
    \u201C\u6211\u542C\u8BF4\u8FDC\u65B9\u6709\u4E00\u4E2A\u91D1\u8272\u7684\u5C0F\u5C9B\uFF0C\u6211\u7684\u68A6\u60F3\u5728\u90A3\u91CC\u3002\u201D\u5C11\u5E74\u8BF4\u9053\u3002\u7537\u5B69\u597D\u5947\u91D1\u8272\u7684\u5C0F\u5C9B\u6709\u4EC0\u4E48\uFF0C\u4F46\u5C11\u5E74\u4E5F\u65E0\u6CD5\u56DE\u7B54\u3002"
  - "\u4E34\u522B\u65F6\uFF0C\u7537\u5B69\u8D60\u4E0E\u5C11\u5E74\u4E00\u5757\u6253\u78E8\u5149\u6ED1\u7684\u8D1D\u58F3\u3002\u4ED6\u8BF4\uFF0C
    \u201C\u8BF7\u4E0D\u8981\u5FD8\u8BB0\u6211\u8FD9\u4E2A\u670B\u53CB\uFF0C\u6211\u4E5F\u4F1A\u6C38\u8FDC\u8BB0\u5F97\u4F60\u7684\u2014\u2014\u201D"
  ch3Images:
  - {fileID: 21300000, guid: fff9c81a69a7b004abb17ea2fedb9c4c, type: 3}
  - {fileID: 21300000, guid: f5085465d2bf83a448e0ada72288058f, type: 3}
  - {fileID: 21300000, guid: 0127a9f253d666344b0ac777b0e4abe4, type: 3}
  - {fileID: 21300000, guid: f8e031099ce15db48bf5d44090f8d5cb, type: 3}
  - {fileID: 21300000, guid: 53adc9ea55fd4b74ea2722910033cd90, type: 3}
  - {fileID: 21300000, guid: 5d3c3b2dda99fb54d92edb43a7be4a94, type: 3}
  ch3Subtitles:
  - "\u65E0\u8FB9\u6697\u84DD\u8272\u5927\u6D77\u4E2D\u592E\uFF0C\u4E00\u5EA7\u5B64\u5C9B\u77D7\u7ACB\uFF0C\u56DB\u5468\u662F\u9661\u5CED\u7684\u9752\u7070\u8272\u65AD\u5D16\uFF0C\u5D16\u58C1\u4E0A\u5BC6\u5BC6\u9EBB\u9EBB\u523B\u6EE1\u4E86\u661F\u661F\u7EB9\u8DEF\uFF0C\u6D77\u6D6A\u649E\u51FB\u5D16\u5E95\u6E85\u8D77\u767D\u8272\u6CE1\u6CAB\u3002"
  - "\u5C11\u5E74\u987A\u7740\u77F3\u9636\u767B\u4E0A\u5C9B\u5C7F\uFF0C\u773C\u524D\u7684\u4E00\u5207\u666F\u8C61\u90FD\u5728\u8BC9\u8BF4\u7740\u6B64\u5730\u7684\u6545\u4E8B\u3002\u4E07\u5343\u661F\u75D5\u7EB5\u6A2A\u4EA4\u9519\uFF0C\u50CF\u4E00\u5377\u88AB\u5C01\u5B58\u5728\u5C71\u5D16\u4E0A\u3001\u5199\u6EE1\u8FDC\u822A\u6545\u4E8B\u7684\u661F\u56FE\u3002"
  - "\u5C9B\u4E0A\u6709\u4E00\u4F4D\u5B88\u661F\u8001\u8005\uFF0C\u4ED6\u5E74\u8F7B\u65F6\u9A7E\u8239\u904D\u5386\u56DB\u6D77\uFF0C\u89C1\u8FC7\u65E0\u6570\u6F02\u6CCA\u65C5\u4EBA\uFF0C\u6BCF\u4E00\u6BB5\u76F8\u9047\u843D\u5E55\uFF0C\u4ED6\u4FBF\u5BFB\u4E00\u5757\u5C16\u77F3\u5728\u5D16\u58C1\u51FF\u4E0B\u4E00\u9897\u661F\uFF0C\u628A\u4EBA\u6D77\u91CC\u6240\u6709\u6E29\u67D4\u4E0E\u9057\u61BE\uFF0C\u7559\u5B58\u4E8E\u8FD9\u7247\u5C71\u5D16\u4E4B\u95F4\u3002"
  - "\u5C11\u5E74\u8D70\u5230\u8001\u8005\u8EAB\u4FA7\u5750\u4E0B\uFF0C\u4F4E\u58F0\u5410\u9732\u5FC3\u5E95\u7684\u56F0\u60D1\uFF1A\u4ED6\u65E5\u65E5\u6267\u7740\u5954\u8D74\u6240\u8C13\u8FDC\u65B9\uFF0C\u53EF\u76F4\u81F3\u6B64\u523B\uFF0C\u4F9D\u65E7\u8BF4\u4E0D\u6E05\u81EA\u5DF1\u82E6\u82E6\u8FFD\u5BFB\u7684\u68A6\u5230\u5E95\u662F\u4EC0\u4E48\u3002"
  - "\u201C\u4F60\u8E0F\u8DB3\u8FC7\u7684\u6BCF\u4E00\u5904\u5C9B\u5C7F\u3001\u840D\u6C34\u76F8\u9022\u9047\u89C1\u7684\u6BCF\u4E00\u4E2A\u4EBA\uFF0C\u90A3\u4E9B\u6E29\u6696\u7684\u76F8\u5904\u3001\u4E0D\u820D\u7684\u522B\u79BB\uFF0C\u5168\u90E8\u62FC\u51D1\u8D77\u6765\uFF0C\u624D\u662F\u4F60\u7A77\u5C3D\u6D77\u8DEF\u60F3\u8981\u5BFB\u627E\u7684\u5B8C\u6574\u4E16\u754C\u3002\u201D\u8BF4\u5B8C\uFF0C\u8001\u8005\u5C06\u4E00\u5757\u9EC4\u94DC\u661F\u76D8\u9012\u7ED9\u4E86\u5C11\u5E74\u3002"
  - "\u79BB\u5F00\u524D\uFF0C\u5C11\u5E74\u5728\u65AD\u5D16\u8FB9\u523B\u4E0B\u5C5E\u4E8E\u661F\u843D\u5C7F\u7684\u661F\u661F\u3002\u5C11\u5E74\u6CA1\u6709\u6CE8\u610F\u5230\uFF0C\u5728\u5D16\u58C1\u7684\u89D2\u843D\uFF0C\u523B\u7740\u4E00\u53E5\u8BDD
    \u201C\u6240\u6709\u822A\u7EBF\u515C\u515C\u8F6C\u8F6C\uFF0C\u6700\u7EC8\u90FD\u4F1A\u56DE\u5230\u6700\u521D\u7684\u8D77\u70B9\u3002\u201D"
  ch4Images:
  - {fileID: 21300000, guid: d7839344942347344a9120701293e2f2, type: 3}
  - {fileID: 21300000, guid: 8004cdc5ea38a34429805c1c316d386b, type: 3}
  - {fileID: 21300000, guid: 7efa16d495368d845bade85544114f73, type: 3}
  - {fileID: 21300000, guid: 8465a5b966587a147a321a7136c1a4f0, type: 3}
  - {fileID: 21300000, guid: 5e7423c7fc2831a47a559c9e615e753c, type: 3}
  - {fileID: 21300000, guid: 8bd7adbd6d1a8554289848b20f3a9d9f, type: 3}
  ch4Subtitles:
  - "\u5C11\u5E74\u6765\u5230\u4E86\u4E00\u7247\u4E1C\u65B9\u7684\u56FD\u5EA6\uFF0C\u5BBD\u5BBD\u7684\u8857\u9053\uFF0C\u4E24\u8FB9\u5E97\u94FA\u9CDE\u6B21\u6809\u6BD4\uFF0C\u7199\u7199\u6518\u6518\u7684\u5927\u8857\u4E0A\u8863\u88D9\u7FFB\u98DE\uFF0C\u800C\u4ED6\u8EAB\u4E0A\u7684\u8863\u670D\u5DF2\u7834\u4E86\u597D\u51E0\u4E2A\u6D1E\u3002"
  - "\u8FD9\u65F6\uFF0C\u4ED6\u6CE8\u610F\u5230\u4E86\u4E00\u4E2A\u5356\u7EB1\u7684\u5973\u5B69\uFF0C\u5979\u4E0E\u4ED6\u6240\u89C1\u8FC7\u7684\u6240\u6709\u5973\u5B69\u90FD\u4E0D\u4E00\u6837\uFF0C\u867D\u8EAB\u7740\u7C97\u5E03\u9EBB\u8863\uFF0C\u5374\u6709\u4E00\u79CD\u5927\u6D77\u822C\u6DF1\u9083\u7684\u6C14\u8D28\u3002"
  - "\u5973\u5B69\u5C06\u4E00\u5757\u6F02\u4EAE\u7684\u7EB1\u5E03\u9012\u5230\u5C11\u5E74\u7684\u9762\u524D\uFF0C\u201C\u5C11\u5E74\uFF0C\u4E70\u5E03\u5417\uFF1F\u201D\u90A3\u6E29\u67D4\u7684\u7B11\u989C\u8BA9\u5C11\u5E74\u7EA2\u4E86\u8138\u5E9E\u3002"
  - "\u5973\u5B69\u5E2E\u5C11\u5E74\u8865\u597D\u4E86\u8863\u670D\uFF0C\u770B\u8D77\u6765\u5D2D\u65B0\u5982\u521D\u3002\u9017\u7559\u5728\u5927\u9646\u4E0A\u7684\u65E5\u5B50\uFF0C\u5C11\u5E74\u5929\u5929\u548C\u5973\u5B69\u5728\u4E00\u8D77\u3002\u4ED6\u5E2E\u5973\u5B69\u5356\u7EB1\uFF0C\u5E76\u5F97\u77E5\u4E86\u5979\u7684\u8EAB\u4E16\uFF0C\u539F\u6765\u5979\u662F\u9C9B\u4EBA\u3002"
  - "\u5927\u98CE\u8981\u6765\u4E86\uFF0C\u8FD9\u8BA9\u5C11\u5E74\u4E0D\u5F97\u4E0D\u63D0\u524D\u79BB\u5F00\u3002\u5973\u5B69\u6D41\u4E0B\u4E86\u4E0D\u820D\u7684\u6CEA\u6C34\uFF0C\u5E0C\u671B\u5C11\u5E74\u7559\u4E0B\u6765\uFF0C\u53EF\u662F\u5C11\u5E74\u8981\u53BB\u8FDC\u65B9\u627E\u5230\u4ED6\u7684\u68A6\u60F3\u3002"
  - "\u5973\u5B69\u7684\u773C\u6CEA\u6389\u843D\u5728\u76D8\u91CC\u7ADF\u5168\u5316\u4E3A\u4E86\u4E00\u9897\u4E00\u9897\u95EA\u4EAE\u7684\u73CD\u73E0\u3002\u5979\u5C06\u73CD\u73E0\u9012\u7ED9\u5C11\u5E74\uFF0C\u5C11\u5E74\u7684\u773C\u91CC\u4E5F\u6CDB\u8D77\u4E86\u6CEA\u82B1\uFF0C\u201C\u6211\u4E00\u5B9A\u4F1A\u56DE\u6765\u770B\u4F60\u7684\u2014\u2014\u201D"
  ch5Images:
  - {fileID: 21300000, guid: bb11dda0c3d20f549a07de82f626bd8b, type: 3}
  - {fileID: 21300000, guid: 06c0f15e1d0165b4984cd8d568a1b428, type: 3}
  - {fileID: 21300000, guid: 4e7a4b1addfd20544a11598903f0cd4e, type: 3}
  - {fileID: 21300000, guid: abcdb7c707e337e408f59d517eb55f86, type: 3}
  - {fileID: 21300000, guid: 974dfb0e1d9346646aeede33804173cf, type: 3}
  ch5Subtitles:
  - "\u76F4\u5230\u4E00\u5929\u508D\u665A\uFF0C\u5C11\u5E74\u6765\u5230\u4E86\u4E00\u7247\u4ECE\u672A\u6765\u8FC7\u7684\u6D77\u57DF\u3002\u90A3\u592A\u9633\u4E0B\u843D\u7684\u5730\u65B9\uFF0C\u6709\u7740\u4E00\u4E2A\u91D1\u8272\u7684\u5C0F\u5C9B\uFF0C\u90A3\u4E00\u523B\uFF0C\u5C11\u5E74\u770B\u5230\u4E86\u4ED6\u4E00\u751F\u4E2D\u6240\u89C1\u8FC7\u7684\u6700\u58EE\u89C2\u7684\u666F\u8C61\uFF0C\u800C\u89C6\u7EBF\u5C3D\u5934\u7684\u90A3\u4E2A\u5C0F\u5C9B\uFF0C\u4E0D\u6B63\u662F\u4ED6\u513F\u65F6\u6240\u5411\u5F80\u7684\uFF0C\u90A3\u5927\u6D77\u4E0E\u5929\u7A7A\u7684\u4EA4\u754C\u4E4B\u6240\u5728\u5417\uFF1F"
  - "\u5C11\u5E74\u7684\u53CC\u624B\u7D27\u7D27\u4EA4\u63E1\uFF0C\u4ED6\u8FEB\u4E0D\u53CA\u5F85\u8DF3\u4E0B\u8239\uFF0C\u96BE\u9053\u8FD9\u5C31\u662F\u4ED6\u5386\u5C3D\u5343\u8F9B\u4E07\u82E6\u5BFB\u89C5\u7684\u68A6\u60F3\u4E2D\u7684\u4E16\u754C\u5417\uFF1F\u6B64\u523B\uFF0C\u4ED6\u89C9\u5F97\u81EA\u5DF1\u8981\u878D\u5316\u5728\u8FD9\u6D41\u91D1\u7684\u5915\u9633\u91CC\u4E86\u3002"
  - "\u5C11\u5E74\u8D70\u7740\u8D70\u7740\uFF0C\u5374\u53C8\u4E00\u6B21\u5267\u70C8\u98A4\u6296\u4E86\u8D77\u6765\u3002\u4ED6\u75AF\u4E86\u4F3C\u7684\u5954\u8DD1\u8D77\u6765\u3002"
  - "\u5C11\u5E74\u6700\u540E\u505C\u5728\u4E86\u4E00\u5EA7\u5C0F\u5C0F\u7684\u6728\u5C4B\u524D\uFF0C\u770B\u5230\u4E86\u719F\u6089\u7684\u8001\u4EBA\uFF0C\u4E0D\u8FC7\u8001\u4EBA\u7684\u5934\u53D1\u4E0D\u518D\u662F\u7070\u767D\uFF0C\u800C\u662F\u6EE1\u5934\u767D\u53D1\uFF0C\u8138\u4E0A\u7684\u76B1\u7EB9\u4E5F\u52A0\u6DF1\u4E86\u8BB8\u591A\u3002"
  - "\u5C11\u5E74\u4E0A\u524D\u4E00\u628A\u62B1\u4F4F\u7237\u7237\uFF0C\u7237\u7237\u8F7B\u8F7B\u62CD\u6253\u4ED6\u7684\u540E\u80CC\uFF0C\u8BF4\u7740\u201C\u56DE\u6765\u4E86\u5C31\u597D\uFF0C\u56DE\u6765\u4E86\u5C31\u597D\u201D\u3002"
